# Generate one random key and put the raw value in Quena's ignored .env.local.
WAHA_API_KEY=replace-with-a-long-random-secret
# SHA-512 hex digest of the exact raw key above. WAHA stores/verifies this hash.
WAHA_API_KEY_SHA512=replace-with-128-character-sha512-hex
# Optional image override for x86_64: devlikeapro/waha:gows-2026.9.2
WAHA_IMAGE=devlikeapro/waha:gows-arm-2026.9.2
